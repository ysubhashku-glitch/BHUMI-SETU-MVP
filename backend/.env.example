# ==============================================================================
# BhumiSetu Canonical Staging / Production Environment Configuration Template
# ==============================================================================
# Security Notice:
# 1. Never commit real credentials, passwords, private keys, or API tokens.
# 2. In staging/production, SECRET_KEY must be >= 32 characters and cryptographically random.
# 3. Rotate SECRET_KEY and DB credentials every 90 days or immediately upon team changes.
# ==============================================================================

# Project & Deployment Context
PROJECT_NAME="BhumiSetu Land Intelligence Platform"
ENVIRONMENT="staging"                 # Options: 'development', 'test', 'staging', 'production'
DEBUG="false"                         # Strictly false in staging/production

# CORS Security: Comma-separated list of trusted frontend origins. Wildcard '*' is rejected in staging.
ALLOWED_ORIGINS="https://staging.bhumisetu.gov.in,https://admin.staging.bhumisetu.gov.in"

# Database: PostgreSQL 16 + PostGIS 3.4
# Staging/Production Container Infrastructure Variables
POSTGRES_USER="bhumisetu_user"
POSTGRES_PASSWORD="replace_with_strong_staging_db_password_2026"
POSTGRES_DB="bhumisetu_db"

# Format: postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL="postgresql+psycopg://bhumisetu_user:replace_with_strong_staging_db_password_2026@db:5432/bhumisetu_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & JWT Configuration
# Generate with: openssl rand -hex 32
SECRET_KEY="replace_with_a_64_character_hexadecimal_cryptographically_secure_random_string_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 Hours

# Evidence Vault & Storage Provider
# Options: 'local', 's3', 'minio'
STORAGE_ADAPTER="s3"
STORAGE_DIR="./storage/documents"
AWS_S3_BUCKET="bhumisetu-staging-evidence-vault"
AWS_ACCESS_KEY_ID="replace_with_s3_or_minio_access_key_id"
AWS_SECRET_ACCESS_KEY="replace_with_s3_or_minio_secret_access_key"
AWS_REGION="ap-south-1"
# S3_ENDPOINT_URL is required for MinIO or custom S3-compatible endpoints:
# S3_ENDPOINT_URL="http://minio:9000"
# Staging MinIO Vault Root Credentials:
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="replace_with_strong_minio_root_password_2026"
S3_USE_SSL="true"

# Asynchronous Workflows (Celery & Redis)
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"
ASYNC_PROCESSING="true"

# Default Organization & Tenant Configuration
DEFAULT_TENANT_NAME="BhumiSetu Staging Operations"
DEFAULT_TENANT_SLUG="bhumisetu-staging"
PUBLIC_BASE_URL="https://staging.bhumisetu.gov.in"

# Model Context Protocol (MCP) Governed Interface
MCP_ENABLED="true"
MCP_SERVER_NAME="bhumi-setu-agent-mcp"
MCP_TRANSPORT="stdio"
MCP_HOST="127.0.0.1"
MCP_PORT=8001
MCP_ALLOW_STATE_MUTATIONS="true"
